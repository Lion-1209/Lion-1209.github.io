---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

interface Project {
	name: string;
	desc: string;
	tech: string[];
	url: string;
}

const projects: Project[] = [
	{
		name: "coderio",
		desc: "本地 coding agent，原生支持智谱 GLM / 阶跃 Coding Plan。四道硬约束测试门——Agent 不跑完测试，不许声称完成。",
		tech: ["Python", "Agent", "GLM"],
		url: "https://github.com/Lion-1209/coderio",
	},
	{
		name: "flashgate",
		desc: "硬件在环验证门：build → flash → boot banner → exit code。固件不在真实板子上跑通，Agent 就无法交付。",
		tech: ["Python", "ESP32", "HIL"],
		url: "https://github.com/Lion-1209/flashgate",
	},
	{
		name: "WhaleDock 鲸屿",
		desc: 'Datawhale 智能桌搭：ESP32-S3 + 7.5" 三色墨水屏，固件、上位机、结构件全开源。',
		tech: ["C++", "ESP32-S3", "E-Ink"],
		url: "https://github.com/Lion-1209/WhaleDock-Project",
	},
	{
		name: "wiki-web",
		desc: "Markdown 知识库的自托管 Web UI：浏览、BM25 搜索、链接关系图、lint 面板。无需 Obsidian，无需数据库。",
		tech: ["JavaScript", "Self-hosted"],
		url: "https://github.com/Lion-1209/wiki-web",
	},
	{
		name: "眠息 SleepPulse AirSense",
		desc: "家庭睡眠呼吸监测 PC 服务端：STM32 采集 + WebSocket 实时波形 + 可切换 LLM 分析 + 定时报告。",
		tech: ["STM32", "WebSocket", "LLM"],
		url: "https://github.com/Lion-1209/sleeppulse-airsense",
	},
	{
		name: "Lion-Skills",
		desc: "面向开发者的 agent skills 套件：11 个工作流 skill，覆盖测试、调试、任务拆解等场景。",
		tech: ["JavaScript", "Agent Skills"],
		url: "https://github.com/Lion-1209/dsh-plugin-lion-skills",
	},
	{
		name: "AgentStudy",
		desc: "Agent 开发学习记录：本站 16 篇系列教程的配套代码，从 ReAct 循环到多智能体编排。",
		tech: ["Python", "Tutorial"],
		url: "https://github.com/Lion-1209/AgentStudy",
	},
	{
		name: "ThousandSailAgent",
		desc: "多 AI Agent 编排框架：用声明式 YAML 定义 Agent 协作流程。",
		tech: ["TypeScript", "Multi-Agent"],
		url: "https://github.com/Lion-1209/ThousandSailAgent",
	},
];
---
<MainGridLayout title="项目" description="Lion 的开源项目：AI Agent 工具链、智能硬件、知识管理">
	<div class="flex flex-col gap-4 w-full">
		<div class="card-base px-9 py-6 rounded-[var(--radius-large)]">
			<h1 class="text-3xl font-bold text-90 mb-2 transition">开源项目</h1>
			<p class="text-75">
				AI Agent 工具链、智能硬件、知识管理系统。全部开源在
				<a class="underline decoration-dashed hover:text-[var(--primary)] transition" href="https://github.com/Lion-1209" target="_blank" rel="noopener">GitHub</a>，
				欢迎 Star 和交流。
			</p>
		</div>

		<div class="grid grid-cols-1 gap-4 w-full">
			{
				projects.map((p) => (
					<a
						href={p.url}
						target="_blank"
						rel="noopener"
						class="card-base group px-6 md:px-9 py-6 rounded-[var(--radius-large)] transition active:scale-[0.99]"
					>
						<div class="flex items-center gap-3 mb-2">
							<span class="font-bold text-2xl text-90 transition group-hover:text-[var(--primary)]">
								{p.name}
							</span>
							<Icon
								name="fa6-brands:github"
								class="text-xl text-black/30 dark:text-white/30 transition group-hover:text-[var(--primary)]"
							/>
						</div>
						<div class="text-75 mb-4">{p.desc}</div>
						<div class="flex flex-wrap gap-2">
							{p.tech.map((t) => (
								<span class="text-sm px-2.5 py-0.5 rounded-lg bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50">
									{t}
								</span>
							))}
						</div>
					</a>
				))
			}
		</div>
	</div>
</MainGridLayout>
