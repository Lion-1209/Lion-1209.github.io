			width: 14px;
			height: 14px;
		}

		/* ═══ 响应式 ═══ */
		@media (max-width: 900px) {
			.about-grid {
				grid-template-columns: 1fr;
				gap: 36px;
			}
			.side-tag {
				display: none;
			}
		}
		@media (max-width: 640px) {
			.menu-btn {
				display: grid;
			}
			.avatar {
				width: 76px;
				height: 76px;
				margin-bottom: 22px;
			}
			.hero-role {
				font-size: 0.95rem;
				letter-spacing: 0.04em;
			}
			.nav-links {
				position: absolute;
				top: calc(100% + 10px);
				right: 4vw;
				left: 4vw;
				flex-direction: column;
				gap: 4px;
				padding: 14px;
				background: rgba(7, 13, 30, 0.92);
